# Copy to .env and replace every CHANGE_ME value before deployment.
NODE_ENV=development
WEB_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000/api
COOKIE_SECURE=false
TRUST_PROXY=false
PORT=4000
DB_POOL_MAX=15
DB_SSL=false
POSTGRES_DB=onion_quality
POSTGRES_USER=onion_app
POSTGRES_PASSWORD=CHANGE_ME_USE_A_LONG_RANDOM_PASSWORD
REDIS_PASSWORD=CHANGE_ME_USE_ANOTHER_LONG_RANDOM_PASSWORD
JWT_ACCESS_SECRET=CHANGE_ME_REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES_64_HEX_IS_BETTER
AI_SERVICE_TOKEN=CHANGE_ME_USE_A_SEPARATE_RANDOM_64_HEX_SECRET
UPLOAD_DIR=../../data/uploads
MAX_UPLOAD_BYTES=15728640
MAX_SCAN_BYTES=104857600
MAX_FILES_PER_SCAN=30
AI_REQUEST_TIMEOUT_MS=90000
SCAN_WORKER_CONCURRENCY=2
AUDIT_HASH_SALT=CHANGE_ME_RANDOM_AUDIT_HASH_SALT
ML_PIPELINE_CALLBACK_TOKEN=CHANGE_ME_RANDOM_CALLBACK_TOKEN_AT_LEAST_32_CHARS
ML_RETRAIN_GITHUB_TOKEN=
ML_RETRAIN_GITHUB_REPOSITORY=YOUR_ORG/YOUR_REPO
ML_RETRAIN_GITHUB_WORKFLOW=retrain-model.yml
ML_RETRAIN_GITHUB_REF=main
LOG_LEVEL=info

# Host-run development overrides only. Keep these distinct from Compose service URLs.
HOST_DATABASE_URL=postgresql://onion_app:CHANGE_ME_USE_THE_POSTGRES_PASSWORD@localhost:5432/onion_quality
HOST_REDIS_URL=redis://:CHANGE_ME_USE_THE_REDIS_PASSWORD@localhost:6379
HOST_AI_SERVICE_URL=http://localhost:8000

# AI service
ENVIRONMENT=development
DETECTOR_WEIGHTS_PATH=/models/onion-detector.pt
CLASSIFIER_WEIGHTS_PATH=/models/onion-quality-classifier.pt
MODEL_VERSION=onion-quality-v1
DEVICE=auto
CONFIDENCE_THRESHOLD=0.25
MAX_IMAGES_PER_REQUEST=30
MAX_IMAGE_SIDE=4096
MAX_PIXELS=20000000
